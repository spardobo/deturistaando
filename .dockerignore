.env
.env.*
**/.env
**/.env.*
**/secrets/
auth.json

*.cer
*.crt
*.key
*.p12
*.pem
*.pfx

##############################################################################
# Installed dependencies and local frontend output
##############################################################################
node_modules/
vendor/
public/build/
public/hot
public/storage

##############################################################################
# Runtime-generated state, caches, and reports
##############################################################################
bootstrap/cache/*
storage/debugbar/
storage/framework/cache/data/
storage/framework/sessions/
storage/framework/testing/
storage/framework/views/
storage/logs/

.build-staging/
.cache/
.vite/
build/
coverage/
dist/
tmp/
*.log

##############################################################################
# Development and documentation sources not required at runtime
##############################################################################
docs/
tests/
*.md
LICENSE*
phpstan.neon
phpunit.xml
pint.json

##############################################################################
# Docker, Compose, CI, and packaging metadata
##############################################################################
.dockerignore
Dockerfile*
compose*.yaml
compose*.yml
docker-compose*.yaml
docker-compose*.yml
*ci*.yaml
*ci*.yml
*pipeline*.yaml
*pipeline*.yml

##############################################################################
# Operating-system and downloaded-file metadata
##############################################################################
.DS_Store
Thumbs.db
*:Zone.Identifier
